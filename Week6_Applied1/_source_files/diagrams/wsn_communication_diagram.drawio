<mxfile host="app.diagrams.net">
  <diagram name="WSN Communication Diagram" id="wsn-comm">
    <mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="nb" value="&lt;u&gt;neighbours &#215;4 : ChargingNode&lt;/u&gt;" style="rounded=0;html=1;fillColor=#EFE9F8;strokeColor=#5B2D8E;fontColor=#2B2140;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="50" width="280" height="46" as="geometry" />
        </mxCell>

        <mxCell id="orig" value="&lt;u&gt;node(1,1) : ChargingNode&lt;/u&gt;" style="rounded=0;html=1;fillColor=#5B2D8E;strokeColor=#5B2D8E;fontColor=#FFFFFF;fontSize=12;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="280" height="46" as="geometry" />
        </mxCell>

        <mxCell id="bs" value="&lt;u&gt;baseStation : BaseStation&lt;/u&gt;" style="rounded=0;html=1;fillColor=#EFE9F8;strokeColor=#5B2D8E;fontColor=#2B2140;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="610" width="280" height="46" as="geometry" />
        </mxCell>

        <mxCell id="tgt" value="&lt;u&gt;node(2,1) : ChargingNode&lt;/u&gt;" style="rounded=0;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#7C4DBE;fontColor=#7C4DBE;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="240" y="800" width="280" height="46" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1: NEIGHBOUR_QUERY&#10;MPI_Isend, tag 102" style="endArrow=open;rounded=0;strokeColor=#5B2D8E;fontColor=#5B2D8E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=0;entryX=0.25;entryY=1;strokeWidth=1.5;align=right;spacingRight=6;" edge="1" parent="1" source="orig" target="nb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2: NEIGHBOUR_REPLY&#10;MPI_Isend, tag 103" style="endArrow=open;rounded=0;strokeColor=#7C4DBE;fontColor=#7C4DBE;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.75;entryY=0;strokeWidth=1.5;align=left;spacingLeft=6;" edge="1" parent="1" source="nb" target="orig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3 [all replies over threshold]:&#10;BS_ALERT — packed struct&#10;(MPI_Type_create_struct), tag 100" style="endArrow=open;rounded=0;strokeColor=#5B2D8E;fontColor=#5B2D8E;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.25;entryY=0;strokeWidth=1.5;align=right;spacingRight=6;" edge="1" parent="1" source="orig" target="bs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m31" value="3.1: findClosestAvailable()&#10;Manhattan search of nodeTable" style="endArrow=open;rounded=1;strokeColor=#7C4DBE;fontColor=#7C4DBE;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=1;entryY=0.75;strokeWidth=1.5;curved=1;" edge="1" parent="1" source="bs" target="bs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="640" y="633" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: BS_REDIRECT, tag 101&#10;carries coords of node(2,1)" style="endArrow=open;rounded=0;strokeColor=#7C4DBE;fontColor=#7C4DBE;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.75;entryY=1;strokeWidth=1.5;align=left;spacingLeft=6;" edge="1" parent="1" source="bs" target="orig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5: future vehicles redirected" style="endArrow=open;dashed=1;rounded=1;strokeColor=#7C4DBE;fontColor=#7C4DBE;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1.5;curved=1;" edge="1" parent="1" source="orig" target="tgt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="110" y="600" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="legend" value="UML communication diagram — numbers give message order. Non-blocking sends (1, 2) prevent deadlock when two adjacent nodes query each other simultaneously." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#EFE9F8;strokeColor=#7C4DBE;fontColor=#2B2140;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="180" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
