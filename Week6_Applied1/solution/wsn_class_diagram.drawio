        <mxCell id="e1m2" value="1" style="text;fontSize=10;fontColor=#5B2D8E;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0.85" relative="1" as="geometry" /></mxCell>

        <mxCell id="e2" value="shared memory: threads + mutex" style="endArrow=open;startArrow=diamondThin;startFill=1;startSize=14;rounded=0;strokeColor=#7C4DBE;fontColor=#7C4DBE;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cn" target="cp">
