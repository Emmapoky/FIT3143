        <mxCell id="bs4" value="+ findClosestAvailable(origin) : coords (Manhattan)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;fontSize=11;fontColor=#2B2140;" vertex="1" parent="bs"><mxGeometry y="102" width="330" height="22" as="geometry" /></mxCell>
