        <mxCell id="e3" value="NEIGHBOUR_QUERY / REPLY (tags 102 / 103)&#10;MPI 2-D mesh, adjacent only" style="endArrow=open;startArrow=open;dashed=1;rounded=0;strokeColor=#7C4DBE;fontColor=#7C4DBE;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="cn" target="adj">
