        <mxCell id="note1" value="Node ranks form a 2-D non-periodic Cartesian communicator (MPI_Cart_create); each node finds its neighbours with MPI_Cart_shift. The base station is the last world rank, outside the grid communicator. One MPI process per charging node; K port threads inside each process." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#EFE9F8;strokeColor=#7C4DBE;fontColor=#2B2140;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
