{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "MPI: mpicc build active file (Mac)",
            "command": "/opt/homebrew/bin/mpicc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compile the current C file with Open MPI (brew install open-mpi)."
        },
        {
            "type": "shell",
            "label": "MPI: run active file with 4 processes (Mac)",
            "command": "/opt/homebrew/bin/mpirun",
            "args": [
                "-np",
                "4",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "MPI: mpicc build active file (Mac)",
            "problemMatcher": [],
            "detail": "Build with mpicc, then mpirun -np 4. Change -np here for more processes."
        },
        {
            "type": "cppbuild",
            "label": "OpenMP: gcc-16 build active file (Mac)",
            "command": "/opt/homebrew/bin/gcc-16",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-g",
                "-fopenmp",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compile the current C file with OpenMP via Homebrew gcc-16 (Apple clang needs extra flags for -fopenmp)."
        },
        {
            "type": "cppbuild",
            "label": "Pthreads: gcc build active file (Mac)",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lpthread",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compile the current C file with POSIX threads."
        }
    ],
    "version": "2.0.0"
}
