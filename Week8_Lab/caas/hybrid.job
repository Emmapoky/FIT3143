#!/bin/bash
#SBATCH --job-name=fit3143_hybrid
#SBATCH --time=00:20:00
#SBATCH --mem=16G
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --partition=defq
#SBATCH --output=hybrid.%j.out
####################################################################
# FIT3143 Lab #2 Task 2 - hybrid Open MPI + OpenMP on CAAS.
#
# Team: Erwyna Soo Wen Xin (36555789), Taabish Farooq Bhat (35473932)
#
# One process per node, four threads each. This is the configuration
# the hybrid is actually for: MPI crosses the network once per node,
# and OpenMP does the sharing inside a node where it is cheap.
#
# Submit: sbatch hybrid.job
####################################################################
N=${N:-130000000}

module load openmpi || module load gcc/openmpi || true

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}

mpicc -O2 -fopenmp ../task_2.c -o task_2_caas -lm || exit 1
srun ./task_2_caas $N
